{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Properties": {
      "Application": "NutriCare.API"
    }
  },
  "Jwt": {
    "SecretKey": "your-super-secret-key-change-in-production-minimum-32-characters",
    "Issuer": "NutriCare",
    "Audience": "NutriCareUsers",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(local);Database=NutriCarePro;Trusted_Connection=true;Encrypt=true;TrustServerCertificate=true;"
  },
  "SendGrid": {
    "ApiKey": "",
    "FromEmail": "noreply@nutricare.com",
    "FromName": "NutriCare Pro"
  },
  "Notifications": {
    "Twilio": {
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": ""
    },
    "Events": {
      "AppointmentBooked": {
        "Channels": [ "InApp", "Email" ]
      },
      "AppointmentReminder": {
        "Channels": [ "InApp", "Email", "SMS" ]
      },
      "DietPlanAssigned": {
        "Channels": [ "InApp", "Email" ]
      },
      "PaymentReceived": {
        "Channels": [ "InApp", "Email", "SMS" ]
      },
      "NewMessage": {
        "Channels": [ "InApp" ]
      }
    }
  },
  "AzureBlobStorage": {
    "ConnectionString": "",
    "MedicalReportsContainer": "medical-reports",
    "MaxMedicalReportSizeBytes": 10485760
  },
  "Payments": {
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": ""
    },
    "JazzCash": {
      "MerchantId": "",
      "SecretKey": "",
      "WebhookSecret": "",
      "CheckoutUrl": "",
      "RefundUrl": ""
    },
    "EasyPaisa": {
      "MerchantId": "",
      "SecretKey": "",
      "WebhookSecret": "",
      "CheckoutUrl": "",
      "RefundUrl": ""
    }
  },
  "VideoConsultations": {
    "DefaultTimeZone": "UTC",
    "GoogleMeet": {
      "AccessToken": ""
    },
    "Zoom": {
      "AccessToken": ""
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:3001"
  ],
  "ApiBaseUrl": "https://localhost:7001",
  "FrontendUrl": "http://localhost:3000"
}
